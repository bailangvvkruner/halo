# CRaC-optimized Dockerfile for Spring Boot
# Requires: Azul Zulu JDK with CRaC support or Liberica JDK with CRaC

FROM azul/zulu-openjdk-crac:21 AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g pnpm@10 && \
    rm -rf /var/lib/apt/lists/*

COPY . .

RUN ./gradlew clean downloadPluginPresets build -x check -x generateGitProperties --no-daemon

WORKDIR /build/application
RUN java -Djarmode=layertools -jar build/libs/*.jar extract

# Training run to create CRaC checkpoint
RUN java -XX:CRaCCheckpointTo=checkpoint \
    -cp "dependencies/*:spring-boot-loader/*:snapshot-dependencies/*:application/*" \
    org.springframework.boot.loader.launch.JarLauncher \
    --server.port=8090 &

# Wait for app to start, then trigger checkpoint
RUN sleep 30 && \
    curl -X POST http://localhost:8090/actuator/crac-checkpoint 2>/dev/null || \
    kill -SIGUSR1 $(pgrep -f JarLauncher) || true

################################

FROM azul/zulu-openjdk-crac:21-jre-crac

LABEL maintainer="bailangvvking"

WORKDIR /application

COPY --from=builder /build/application/dependencies/ ./
COPY --from=builder /build/application/spring-boot-loader/ ./
COPY --from=builder /build/application/snapshot-dependencies/ ./
COPY --from=builder /build/application/application/ ./
COPY --from=builder /build/application/checkpoint/ ./checkpoint/

ENV JVM_OPTS="-XX:CRaCRestoreFrom=checkpoint" \
    HALO_WORK_DIR="/root/.halo2" \
    SPRING_CONFIG_LOCATION="optional:classpath:/;optional:file:/root/.halo2/" \
    TZ=Asia/Shanghai

RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8090/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "java ${JVM_OPTS} org.springframework.boot.loader.launch.JarLauncher ${0} ${@}"]
